PORT=3002
NODE_ENV=development

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use uma chave privada com \\n no arquivo .env
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Opcional: Firebase Emulator Suite
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Segurança da API
# Se definido, o backend valida Authorization: Bearer <Firebase ID token>
REQUIRE_FIREBASE_AUTH=false
